rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isBootstrapAdmin() {
      return isAuthenticated() &&
        request.auth.token.email != null &&
        request.auth.token.email in ['locomancocapac@gmail.com'];
    }

    function requesterProfileExists() {
      return exists(/databases/$(database)/documents/perfiles/$(request.auth.uid));
    }

    function requesterProfile() {
      return get(/databases/$(database)/documents/perfiles/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        isBootstrapAdmin() ||
        (
          requesterProfileExists() &&
          requesterProfile().rol == 'admin'
        )
      );
    }

    function hasVerifiedPhone(phone) {
      return request.auth.token.phone_number != null &&
        request.auth.token.phone_number == phone;
    }

    function hasRole(role) {
      return isAuthenticated() &&
        requesterProfileExists() &&
        requesterProfile().rol == role;
    }

    function hasVerifiedPhoneInProfile() {
      return isAuthenticated() &&
        requesterProfileExists() &&
        requesterProfile().get('telefono_verificado', false) == true;
    }

    function isApprovedDriver() {
      return isAuthenticated() &&
        requesterProfileExists() &&
        requesterProfile().rol == 'conductor' &&
        requesterProfile().get('telefono_verificado', false) == true &&
        requesterProfile().get('estado_documentos', 'pendiente') == 'aprobado';
    }

    // 1. Perfiles de usuario (pasajeros, conductores y administradores)
    match /perfiles/{userId} {
      // Evitar raspado masivo (PII): solo administradores pueden listar todos los perfiles.
      // Un usuario autenticado puede consultar perfiles puntuales por ID (contraparte de viaje/oferta).
      allow get: if isAuthenticated();
      allow list: if isAdmin();

      // Creación: los usuarios normales solo pueden registrarse como 'pasajero' o 'conductor',
      // nunca como 'admin', ni auto-aprobarse KYC, ni auto-verificarse el teléfono sin respaldo de Firebase Auth.
      allow create: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.id == userId &&
        request.resource.data.rol in ['pasajero', 'conductor'] &&
        request.resource.data.calificacion_promedio == 5.0 &&
        (
          !('estado_documentos' in request.resource.data) ||
          request.resource.data.estado_documentos == 'pendiente'
        ) &&
        (
          request.resource.data.telefono_verificado == false ||
          hasVerifiedPhone(request.resource.data.telefono)
        )
      );

      // Actualización: impide escalada de privilegios (cambio de rol/id/calificación propia/aprobación KYC)
      // o permite actualizar calificación promedio al evaluar un viaje.
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.rol == resource.data.rol &&
        request.resource.data.rol in ['pasajero', 'conductor'] &&
        request.resource.data.calificacion_promedio == resource.data.calificacion_promedio &&
        request.resource.data.created_at == resource.data.created_at &&
        (
          request.resource.data.get('estado_documentos', null) == resource.data.get('estado_documentos', null) ||
          (
            resource.data.rol == 'conductor' &&
            request.resource.data.get('estado_documentos', null) == 'en_revision'
          )
        ) &&
        (
          request.resource.data.telefono_verificado == false ||
          (
            resource.data.telefono_verificado == true &&
            request.resource.data.telefono == resource.data.telefono
          ) ||
          hasVerifiedPhone(request.resource.data.telefono)
        )
      ) || (
        isAuthenticated() &&
        userId != request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'calificacion_promedio',
          'total_calificaciones',
          'updated_at'
        ]) &&
        request.resource.data.calificacion_promedio is number &&
        request.resource.data.calificacion_promedio >= 1 &&
        request.resource.data.calificacion_promedio <= 5 &&
        request.resource.data.total_calificaciones is int &&
        request.resource.data.total_calificaciones == resource.data.get('total_calificaciones', 1) + 1
      );

      allow delete: if isAdmin();
    }

    // 2. Solicitudes de viaje
    match /solicitudes_viaje/{solicitudId} {
      // Lectura puntual: pasajero dueño, conductor asignado, admin, o solicitudes activas visibles para conductores.
      allow get: if isAuthenticated() && (
        isAdmin() ||
        resource.data.pasajero_id == request.auth.uid ||
        resource.data.conductor_id == request.auth.uid ||
        (hasRole('conductor') && resource.data.estado in ['buscando', 'aceptado', 'cancelada'])
      );

      // Listado: solo dueños, conductores mirando el radar de búsqueda o admins.
      allow list: if isAuthenticated() && (
        isAdmin() ||
        resource.data.pasajero_id == request.auth.uid ||
        resource.data.conductor_id == request.auth.uid ||
        (hasRole('conductor') && resource.data.estado == 'buscando')
      );

      // Creación: únicamente pasajeros con teléfono verificado.
      allow create: if isAdmin() || (
        hasRole('pasajero') &&
        hasVerifiedPhoneInProfile() &&
        request.resource.data.pasajero_id == request.auth.uid &&
        request.resource.data.estado == 'buscando' &&
        request.resource.data.conductor_id == null &&
        request.resource.data.precio_final == null &&
        request.resource.data.precio_inicial is number &&
        request.resource.data.precio_inicial > 0
      );

      // Actualización restringida por rol, campos modificados y máquina de estados:
      allow update: if isAdmin() || (
        isAuthenticated() && (
          // A) Pasajero acepta una oferta de un conductor
          (
            resource.data.pasajero_id == request.auth.uid &&
            resource.data.estado == 'buscando' &&
            request.resource.data.estado == 'aceptado' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'conductor_id', 'precio_final']) &&
            request.resource.data.conductor_id is string &&
            request.resource.data.conductor_id.size() > 0 &&
            request.resource.data.precio_final is number &&
            request.resource.data.precio_final > 0
          ) ||
          // B) Pasajero cancela su solicitud activa
          (
            resource.data.pasajero_id == request.auth.uid &&
            !(resource.data.estado in ['completado', 'cancelada']) &&
            request.resource.data.estado == 'cancelada' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'cancelado_por', 'motivo_cancelacion']) &&
            (!('cancelado_por' in request.resource.data) || request.resource.data.cancelado_por == 'pasajero')
          ) ||
          // C) Conductor asignado avanza el estado del viaje en orden secuencial
          (
            resource.data.conductor_id == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado']) &&
            (
              (resource.data.estado == 'aceptado' && request.resource.data.estado == 'en_camino_origen') ||
              (resource.data.estado == 'en_camino_origen' && request.resource.data.estado == 'en_curso') ||
              (resource.data.estado == 'en_curso' && request.resource.data.estado == 'completado')
            )
          ) ||
          // C2) Conductor asignado cancela un viaje por imprevisto o inasistencia del pasajero
          (
            resource.data.conductor_id == request.auth.uid &&
            resource.data.estado in ['aceptado', 'en_camino_origen', 'en_curso'] &&
            request.resource.data.estado == 'cancelada' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'cancelado_por', 'motivo_cancelacion']) &&
            (!('cancelado_por' in request.resource.data) || request.resource.data.cancelado_por == 'conductor')
          ) ||
          // D) Pasajero o conductor asignado registran calificación sobre un viaje completado (una sola vez)
          (
            resource.data.estado == 'completado' &&
            (
              (
                resource.data.pasajero_id == request.auth.uid &&
                resource.data.get('calificacion_conductor', null) == null &&
                request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                  'calificacion_conductor',
                  'comentario_calificacion'
                ]) &&
                request.resource.data.calificacion_conductor is number &&
                request.resource.data.calificacion_conductor >= 1 &&
                request.resource.data.calificacion_conductor <= 5
              ) ||
              (
                resource.data.conductor_id == request.auth.uid &&
                resource.data.get('calificacion_pasajero', null) == null &&
                request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                  'calificacion_pasajero',
                  'comentario_calificacion'
                ]) &&
                request.resource.data.calificacion_pasajero is number &&
                request.resource.data.calificacion_pasajero >= 1 &&
                request.resource.data.calificacion_pasajero <= 5
              )
            )
          )
        )
      );

      allow delete: if isAdmin() || (
        isAuthenticated() &&
        resource.data.pasajero_id == request.auth.uid &&
        resource.data.estado == 'buscando'
      );
    }

    // 3. Ofertas de conductores (solo conductores aprobados con teléfono verificado)
    match /ofertas_conductores/{ofertaId} {
      // Solo pueden leer la oferta el conductor que la emitió, el pasajero dueño de la solicitud o un admin.
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.conductor_id == request.auth.uid ||
        get(/databases/$(database)/documents/solicitudes_viaje/$(resource.data.solicitud_id)).data.pasajero_id == request.auth.uid
      );

      allow create: if isAdmin() || (
        isApprovedDriver() &&
        request.resource.data.conductor_id == request.auth.uid &&
        request.resource.data.precio is number &&
        request.resource.data.precio > 0 &&
        exists(/databases/$(database)/documents/solicitudes_viaje/$(request.resource.data.solicitud_id)) &&
        get(/databases/$(database)/documents/solicitudes_viaje/$(request.resource.data.solicitud_id)).data.estado == 'buscando'
      );

      allow update: if isAdmin() || (
        isApprovedDriver() &&
        resource.data.conductor_id == request.auth.uid &&
        request.resource.data.conductor_id == resource.data.conductor_id &&
        request.resource.data.solicitud_id == resource.data.solicitud_id &&
        request.resource.data.precio is number &&
        request.resource.data.precio > 0 &&
        exists(/databases/$(database)/documents/solicitudes_viaje/$(resource.data.solicitud_id)) &&
        get(/databases/$(database)/documents/solicitudes_viaje/$(resource.data.solicitud_id)).data.estado == 'buscando'
      );

      allow delete: if isAdmin() || (
        isAuthenticated() &&
        resource.data.conductor_id == request.auth.uid
      );
    }

    // 4. Verificaciones de teléfono (colección legada bloqueada para clientes; OTP vía Firebase Phone Auth)
    match /verificaciones_telefono/{userId} {
      allow read, write: if isAdmin();
    }

    // 5. Configuración global de la plataforma (tarifas y comisiones)
    match /configuracion_plataforma/{docId} {
      allow read: if docId == 'tarifas' || isAuthenticated();
      allow create, update: if isAdmin() &&
        request.resource.data.tarifa_base is number &&
        request.resource.data.tarifa_base >= 0 &&
        request.resource.data.precio_por_km is number &&
        request.resource.data.precio_por_km >= 0 &&
        request.resource.data.tarifa_minima is number &&
        request.resource.data.tarifa_minima > 0 &&
        request.resource.data.comision_porcentaje is number &&
        request.resource.data.comision_porcentaje >= 0 &&
        request.resource.data.comision_porcentaje <= 100;
      allow delete: if isAdmin();
    }

    // 6. Calificaciones mutuas de viajes (inmutables por cliente una vez creadas)
    match /calificaciones_viaje/{calificacionId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.evaluador_id == request.auth.uid &&
        request.resource.data.estrellas is number &&
        request.resource.data.estrellas >= 1 &&
        request.resource.data.estrellas <= 5 &&
        request.resource.data.solicitud_id is string &&
        request.resource.data.rol_evaluador in ['pasajero', 'conductor'] &&
        calificacionId == request.resource.data.solicitud_id + '_' + request.resource.data.rol_evaluador &&
        exists(/databases/$(database)/documents/solicitudes_viaje/$(request.resource.data.solicitud_id)) &&
        get(/databases/$(database)/documents/solicitudes_viaje/$(request.resource.data.solicitud_id)).data.estado == 'completado' &&
        (
          (
            request.resource.data.rol_evaluador == 'pasajero' &&
            get(/databases/$(database)/documents/solicitudes_viaje/$(request.resource.data.solicitud_id)).data.pasajero_id == request.auth.uid
          ) ||
          (
            request.resource.data.rol_evaluador == 'conductor' &&
            get(/databases/$(database)/documents/solicitudes_viaje/$(request.resource.data.solicitud_id)).data.conductor_id == request.auth.uid
          )
        )
      );
      allow update, delete: if isAdmin();
    }
  }
}
