rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        get(/databases/$(database)/documents/perfiles/$(request.auth.uid)).data.rol == 'admin'
      );
    }

    // 1. Perfiles de usuario (pasajeros, conductores y administradores)
    match /perfiles/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. Solicitudes de viaje
    match /solicitudes_viaje/{solicitudId} {
      // Cualquier usuario autenticado puede leer para sincronizar en tiempo real el radar y cambios de estado
      allow read: if isAuthenticated();
      allow create: if (isAuthenticated() && request.resource.data.pasajero_id == request.auth.uid) || isAdmin();
      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.pasajero_id == request.auth.uid ||
        resource.data.conductor_id == request.auth.uid ||
        resource.data.estado == 'buscando'
      );
      allow delete: if (isAuthenticated() && resource.data.pasajero_id == request.auth.uid) || isAdmin();
    }

    // 3. Ofertas de conductores
    match /ofertas_conductores/{ofertaId} {
      allow read: if isAuthenticated();
      allow create: if (isAuthenticated() && request.resource.data.conductor_id == request.auth.uid) || isAdmin();
      allow update, delete: if (isAuthenticated() && resource.data.conductor_id == request.auth.uid) || isAdmin();
    }

    // 4. Verificaciones de teléfono (OTP por SMS)
    match /verificaciones_telefono/{userId} {
      allow read, write: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();
    }
  }
}
