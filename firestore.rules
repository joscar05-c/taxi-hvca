rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Perfiles de usuario (pasajeros y conductores)
    match /perfiles/{userId} {
      // Cualquier usuario autenticado puede leer nombres, vehículos y calificaciones
      allow read: if request.auth != null;
      // Solo el dueño del perfil puede crear o editar su información
      allow create, update: if request.auth != null && request.auth.uid == userId;
    }

    // 2. Solicitudes de viaje
    match /solicitudes_viaje/{solicitudId} {
      // Lectura: si está buscando conductor, o si eres el pasajero o el conductor asignado
      allow read: if request.auth != null && (
        resource.data.estado == 'buscando' ||
        resource.data.pasajero_id == request.auth.uid ||
        resource.data.conductor_id == request.auth.uid
      );
      // Creación: solo el pasajero autenticado asignándose a sí mismo
      allow create: if request.auth != null && request.resource.data.pasajero_id == request.auth.uid;
      // Actualización: pasajero o conductor asignado (o al pasar de buscando a aceptado)
      allow update: if request.auth != null && (
        resource.data.pasajero_id == request.auth.uid ||
        resource.data.conductor_id == request.auth.uid ||
        resource.data.estado == 'buscando'
      );
      // Cancelación/Eliminación: solo el pasajero autor
      allow delete: if request.auth != null && resource.data.pasajero_id == request.auth.uid;
    }

    // 3. Ofertas de conductores
    match /ofertas_conductores/{ofertaId} {
      // Lectura: cualquier usuario autenticado involucrado en la solicitud
      allow read: if request.auth != null;
      // Creación: el conductor autenticado con su propio UID
      allow create: if request.auth != null && request.resource.data.conductor_id == request.auth.uid;
      // Edición y borrado: solo el conductor que emitió la oferta
      allow update, delete: if request.auth != null && resource.data.conductor_id == request.auth.uid;
    }
  }
}
